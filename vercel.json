{
  "installCommand": "cd projeto_completo/projeto/apps/web && npm install",
  "buildCommand": "cd projeto_completo/projeto/apps/web && npx vite build --outDir dist --base /",
  "outputDirectory": "projeto_completo/projeto/apps/web/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
